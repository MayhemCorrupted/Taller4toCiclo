%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialoguesTable_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 87896db2562e33b4eb3af09bcb455886, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 12889339876491264
    m_Localized: "Dichoso sea vuestro llanto, pues vos ser\xE9is consolado, y perdonad
      que teng\xE1is que testiguar mi sentir."
    m_Metadata:
      m_Items: []
  - m_Id: 12889340392390662
    m_Localized: "Levantaos, mi caballero, que en las tinieblas repos\xE1is, ha durado
      demasiado vuestro letargo."
    m_Metadata:
      m_Items: []
  - m_Id: 13087623505133568
    m_Localized: "O\xEDd mi voz y acogedla en vuestro pecho, aunque a\xFAn no sep\xE1is
      qu\xE9 rostro la pronuncia ni desde d\xF3nde os llama."
    m_Metadata:
      m_Items: []
  - m_Id: 13087623656128512
    m_Localized: "Callad el paso, mi caballero. Esos ya no oyen raz\xF3n ni ruego."
    m_Metadata:
      m_Items: []
  - m_Id: 13087623656128513
    m_Localized: "A\xFAn no ten\xE9is con qu\xE9 herirlos. Sortead su mirada, que
      yo os aguardo m\xE1s all\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 13087623656128519
    m_Localized: "Valor hab\xE9is mostrado, mi caballero, mas vuestra carga a\xFAn
      no concluye."
    m_Metadata:
      m_Items: []
  - m_Id: 13087623656128520
    m_Localized: "Un mal vaci\xF3 de alma a los hombres de este reino, y su ra\xEDz
      yace en la Catedral. Tres pilares de luz sellan su puerta."
    m_Metadata:
      m_Items: []
  - m_Id: 13087623656128521
    m_Localized: "Volved al bosque y quebradlos con vuestro acero. Solo as\xED se
      abrir\xE1 el camino."
    m_Metadata:
      m_Items: []
  - m_Id: 13087623656128524
    m_Localized: "L\xE1grima de Redoma: Sana lentamente vuestras heridas."
    m_Metadata:
      m_Items: []
  - m_Id: 13087623656128525
    m_Localized: "\xD3leo de la Carro\xF1a: Da pujanza al acero a costa de vuestra
      salud."
    m_Metadata:
      m_Items: []
  - m_Id: 13087623656128526
    m_Localized: 'Agua de la Memoria: Despierta vuestro vigor y acrecienta una aptitud.'
    m_Metadata:
      m_Items: []
  - m_Id: 13087623656128527
    m_Localized: "Prudente elecci\xF3n. Bebedla cuando la oscuridad os reclame."
    m_Metadata:
      m_Items: []
  - m_Id: 13087623656128528
    m_Localized: "Osado sois. Aqu\xED todo poder exige tributo; no dej\xE9is que
      el \xF3leo os devore."
    m_Metadata:
      m_Items: []
  - m_Id: 13087623656128529
    m_Localized: "Aferraos pues a ese eco de vuestro pasado. Que el recuerdo de lo
      que alguna vez fuisteis os d\xE9 firmeza."
    m_Metadata:
      m_Items: []
  - m_Id: 13166523996323840
    m_Localized: "Me alegra verte, mi buen caballero, digame, \xBFQu\xE9 es lo que
      deseas?"
    m_Metadata:
      m_Items: []
  - m_Id: 13166524747104256
    m_Localized: Quiero fortalecerme
    m_Metadata:
      m_Items: []
  - m_Id: 13166524747104257
    m_Localized: Nada por ahora
    m_Metadata:
      m_Items: []
  - m_Id: 13166524747104258
    m_Localized: "Descansad. Lo que el camino os quit\xF3, yo os lo devuelvo; mas
      lo que abatisteis volver\xE1 a alzarse."
    m_Metadata:
      m_Items: []
  - m_Id: 13166524747104259
    m_Localized: "Que el recuerdo os d\xE9 fuerza."
    m_Metadata:
      m_Items: []
  - m_Id: 14141076897677312
    m_Localized: "Aqu\xED os aguardar\xE9, que otro lugar no tengo."
    m_Metadata:
      m_Items: []
  - m_Id: 14141077191278592
    m_Localized: "Aqu\xED os aguardar\xE9, que otro lugar no tengo."
    m_Metadata:
      m_Items: []
  - m_Id: 14747556141613056
    m_Localized: "Yo me postr\xE9 ante mi se\xF1or, y vi alzarse vuestra mano, mas
      no para bendecirme. Toda mi vida os serv\xED, y toda mi vida os cre\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 14747556208721920
    m_Localized: "Y no fue por pecado m\xEDo, sino por vuestro cruel solaz. Quebrantasteis
      mi ser, como quien parte sin piedad un juguete que ya no le divierte."
    m_Metadata:
      m_Items: []
  - m_Id: 14747556208721921
    m_Localized: "Os suplico clemencia, Se\xF1or m\xEDo. Mas veo que jam\xE1s os
      importamos, ni yo ni cuantos creyeron por m\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 14747556208721922
    m_Localized: "M\xEDa fue la fe, y m\xEDa la ceguera."
    m_Metadata:
      m_Items: []
  - m_Id: 14747556208721923
    m_Localized: "A quien me oiga, sea dios, sea lo que fuere, que habite m\xE1s
      all\xE1 de este cielo cerrado..."
    m_Metadata:
      m_Items: []
  - m_Id: 14747556208721924
    m_Localized: Ayudadme.
    m_Metadata:
      m_Items: []
  - m_Id: 14747556208721925
    m_Localized: "Al fin lleg\xE1is a mi cobijo, mi buen caballero. Soy apenas un
      alma cautiva en esta piedra, mas el destino ha querido que sea yo quien vele
      por vuestros pasos."
    m_Metadata:
      m_Items: []
  - m_Id: 14747556208721926
    m_Localized: "De m\xED no resta sino este m\xE1rmol agrietado y mi palabra. Mas
      mi voz ser\xE1 lumbre en vuestra desventura."
    m_Metadata:
      m_Items: []
  - m_Id: 14747556208721927
    m_Localized: No os quiero indefenso ante esos pobres desdichados que han perdido
      el alma.
    m_Metadata:
      m_Items: []
  - m_Id: 15794610445631488
    m_Localized: Tomad esta hoja, mi caballero. Anathema se llama. Aferraos a ella
      aunque sus espinas os hieran, que solo su filo comparte vuestra condena.
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815680
    m_Localized: "Probad su temple con quienes os cierren el paso, y volved a m\xED,
      que bajo mi sombra hallar\xE9is reposo."
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815681
    m_Localized: '"Inserte texto de recordar de derrotar a los errantes"'
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815682
    m_Localized: "\"Inserte Texto confirmando si se derrot\xF3 a los enemigos\""
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815683
    m_Localized: '"Inserte texto confirmando la mision"'
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815684
    m_Localized: '"Inserte texto de recordar destruir los pilares"'
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815685
    m_Localized: '"Inserte texto de confirmar si destruyo los pilares"'
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815686
    m_Localized: "\"Inserte texto de confirmar la destrucci\xF3n de los pilares\""
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815687
    m_Localized: '"Inserte texto confirmando si destruyo a los enemigos y los pilares" '
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815688
    m_Localized: '"Inserte texto afirmandolo"'
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815689
    m_Localized: "Una vez dentro, habr\xE9is de buscar a quien desat\xF3 toda esta
      desdicha. Hallad al Profeta y dadle muerte, os lo ruego, para que tras tantos
      a\xF1os salga al fin de su miseria."
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815690
    m_Localized: "Mas no part\xE1is con las manos vac\xEDas. De una de estas reliquias
      puedo desprenderme; escoged con tiento:"
    m_Metadata:
      m_Items: []
  - m_Id: 15794610751815691
    m_Localized: '"Inserte texto explicando lo del A pero sabiendo que hizo lo de
      los pilares antes"'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
